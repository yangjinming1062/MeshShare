{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshShare",
  "version": "0.1.0",
  "identifier": "com.meshshare.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MeshShare · 局域网共享",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../web/dist": "web"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
