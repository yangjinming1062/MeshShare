{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshShare",
  "version": "0.1.0",
  "identifier": "com.meshshare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MeshShare · 局域网共享",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "monitor",
        "title": "MeshShare · 硬件监控",
        "url": "index.html?window=monitor",
        "width": 440,
        "height": 42,
        "minWidth": 360,
        "minHeight": 36,
        "maxWidth": 720,
        "maxHeight": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http: ws:"
    },
    "trayIcon": {
      "id": "meshshare",
      "iconPath": "icons/32x32.png",
      "showMenuOnLeftClick": false,
      "tooltip": "MeshShare"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../web/dist": "web"
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "packaging/remove-autostart.nsh"
      },
      "wix": {
        "fragmentPaths": ["packaging/remove-autostart.wxs"]
      }
    },
    "linux": {
      "deb": {
        "postRemoveScript": "packaging/remove-autostart.sh"
      },
      "rpm": {
        "postRemoveScript": "packaging/remove-autostart.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NjA4RDU1Q0VFQUExQzYKUldUR29lck9WWTFnbHdldXRscVE0Uy95YjZWenVBbG5URjNyUmk1THhxbmJWWlp2SGxSWHlVQXUK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/yangjinming1062/MeshShare/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
